'; }\n  fetch('\u002Fapi\u002Flead', { method: 'POST', headers: { 'Content-Type': 'application\u002Fjson' }, body: JSON.stringify(payload) })\n    .then((res) => res.json().then((body) => ({ ok: res.ok, body })))\n    .then(({ ok, body }) => {\n      if (ok && body.success) { alert(t.formAlert); form.reset(); }\n      else { alert((body && body.error) || 'Erro ao enviar. Tente novamente.'); }\n    })\n    .catch(() => alert('Erro ao enviar. Tente novamente.'))\n    .finally(() => { if (btn) { btn.disabled = false; btn.style.opacity = '1'; } });\n},\n      services: t.services,\n      checklist: t.checklist,\n      reasons: t.reasons,\n      reviews: t.reviews,\n      svcOpt0: t.services[0].title,\n      svcOpt1: t.services[1].title,\n      svcOpt2: t.services[2].title,\n      areas: ['San Diego','La Jolla','Pacific Beach','Chula Vista','Coronado','National City','Point Loma','Mission Valley','Clairemont','Carlsbad','Encinitas'],\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"</script>
