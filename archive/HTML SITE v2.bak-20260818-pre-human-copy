onal, pontual e prestou atenção excepcional a cada detalhe. Tudo ficou impecavelmente limpo, e o nível de cuidado superou minhas expectativas. Recomendo muito os serviços e certamente vou contratar novamente.' },\n        ],\n      },\n    };\n    const t = T[lang] || T.en;\n    const mk = (l) => () => { try { localStorage.setItem('ezLang', l); } catch(e){} this.setState({ lang: l }); };\n    const activeBtn = { padding:'5px 12px', borderRadius:'999px', border:'none', cursor:'pointer', fontSize:'13px', fontWeight:700, background:'linear-gradient(115deg,#6DB33F,#1E5FD0)', color:'#fff' };\n    const idleBtn = { padding:'5px 12px', borderRadius:'999px', border:'none', cursor:'pointer', fontSize:'13px', fontWeight:600, background:'transparent', color: scrolled ? '#3B475C' : 'rgba(255,255,255,0.92)' };\n    const langWrapStyle = { display:'flex', alignItems:'center', gap:'3px', padding:'3px', borderRadius:'999px', background: scrolled ? '#EEF2F7' : 'rgba(255,255,255,0.14)', border: scrolled ? '1px solid #E1E8F0' : '1px solid rgba(255,255,255,0.28)' };\n    const menuOpen = this.state.menuOpen;\n    const menuBtnStyle = { flex:'none', width:'40px', height:'40px', border:'none', borderRadius:'10px', background: menuOpen ? (scrolled ? '#EEF2F7' : 'rgba(255,255,255,0.18)') : 'transparent', cursor:'pointer', flexDirection:'column', alignItems:'center', justifyContent:'center', gap:'5px', padding:0 };\n    const menuBarStyle = { display:'block', width:'20px', height:'2px', borderRadius:'2px', background: scrolled ? '#0E2A63' : '#ffffff', transition:'transform .25s' };\n    const mobileMenuStyle = { display: menuOpen ? 'flex' : 'none', flexDirection:'column', gap:'18px', padding:'22px 24px 28px', background:'#ffffff', borderTop:'1px solid #E7ECF1', boxShadow:'0 16px 30px rgba(14,42,99,0.12)' };\n    return {\n      headerStyle,\n      textColor: scrolled ? '#0E2A63' : '#ffffff',\n      linkColor: scrolled ? '#3B475C' : 'rgba(255,255,255,0.9)',\n      t, lang,\n      setEN: mk('en'), setES: mk('es'), setPT: mk('pt'),\n      langWrapStyle,\n      menuBtnStyle, menuBarStyle, mobileMenuStyle,\n      toggleMenu: () => this.setState({ menuOpen: !this.state.menuOpen }),\n      closeMenu: () => this.setState({ menuOpen: false }),\n      enStyle: lang==='en'?activeBtn:idleBtn,\n      esStyle: lang==='es'?activeBtn:idleBtn,\n      ptStyle: lang==='pt'?activeBtn:idleBtn,\n      onSubmit: (e) => {\n  e.preventDefault();\n  const form = e.target;\n  const btn = form.querySelector('button[type=submit]');\n  const data = new FormData(form);\n  const payload = Object.fromEntries(data.entries());\n  const attribution = getStoredAttributionForSubmit();\n  payload.utm_source = attribution.utm_source;\n  payload.utm_medium = attribution.utm_medium;\n  payload.utm_campaign = attribution.utm_campaign;\n  payload.gclid = attribution.gclid;\n  if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }\n  fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })\n    .then((res) => res.json().then((body) => ({ ok: res.ok, body })))\n    .then(({ ok, body }) => {\n      if (ok && body.success) { form.reset(); window.location.href = '/subscribed'; }\n      else { alert((body && body.error) || 'Erro ao enviar. Tente novamente.'); }\n    })\n    .catch(() => alert('Erro ao enviar. Tente novamente.'))\n    .finally(() => { if (btn) { btn.disabled = false; btn.style.opacity = '1'; } });\n},\n      formatPhone: (e) => {\n  var digits = '';\n  var raw = e.target.value;\n  for (var i = 0; i < raw.length; i++) { if (raw[i] >= '0' && raw[i] <= '9') digits += raw[i]; }\n  digits = digits.slice(0, 10);\n  var formatted = digits;\n  if (digits.length > 6) { formatted = '(' + digits.slice(0,3) + ') ' + digits.slice(3,6) + '-' + digits.slice(6); }\n  else if (digits.length > 3) { formatted = '(' + digits.slice(0,3) + ') ' + digits.slice(3); }\n  else if (digits.length > 0) { formatted = '(' + digits; }\n  e.target.value = formatted;\n},\n      services: t.services,\n      checklist: t.checklist,\n      reasons: t.reasons,\n      reviews: t.reviews,\n      svcOpt0: t.services[0].title,\n      svcOpt1: t.services[1].title,\n      svcOpt2: t.services[2].title,\n      areas: ['San Diego','La Jolla','Pacific Beach','Chula Vista','Coronado','National City','Point Loma','Mission Valley','Clairemont','Carlsbad','Encinitas'],\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"</script>
